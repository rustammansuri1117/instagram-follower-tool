SECRET_KEY=change-me-to-a-long-random-string

# Option A: Full connection URI (used by Render PostgreSQL, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Option B: Individual MySQL credentials (for local MySQL or MySQL hosting)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=instagram_growth_db

# Initial Admin user creation on deploy (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123

# App Settings
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
CONTACT_EMAIL=support@example.com
CONTACT_PHONE=+91 00000 00000

